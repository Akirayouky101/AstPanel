{
  "version": 2,
  "builds": [
    { "src": "Api/**/*.js", "use": "@vercel/node" },
    { "src": "**/*.html", "use": "@vercel/static" },
    { "src": "**/*.js", "use": "@vercel/static" },
    { "src": "**/*.css", "use": "@vercel/static" },
    { "src": "**/*.json", "use": "@vercel/static" },
    { "src": "**/*.jpg", "use": "@vercel/static" },
    { "src": "**/*.png", "use": "@vercel/static" },
    { "src": "**/*.svg", "use": "@vercel/static" },
    { "src": "**/*.ico", "use": "@vercel/static" },
    { "src": "**/*.webmanifest", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/manifest", "dest": "/Api/manifest.js" },
    { "src": "/", "status": 302, "headers": { "Location": "/Admin/index.html" } },
    {
      "src": "/(.*)\\.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Pragma": "no-cache"
      },
      "continue": true
    },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
